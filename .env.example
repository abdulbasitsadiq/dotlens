# copy to .env — used by docker-compose and dotlens-node
DATABASE_URL=postgres://dotlens:dotlens@localhost:5432/dotlens
RAW_STORE_PATH=./data/raw
# MinIO (raw store S3 backend, later phase; fs backend is default in Phase 0)
MINIO_ROOT_USER=dotlens
MINIO_ROOT_PASSWORD=dotlens-dev-secret
API_BIND=127.0.0.1:8080
RUST_LOG=info,dotlens=debug
